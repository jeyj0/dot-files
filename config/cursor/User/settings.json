{
  "window.zoomLevel": 2,
  "workbench.preferredLightColorTheme": "Tokyo Night Light",
  "window.autoDetectColorScheme": true,
  "workbench.chat.experimental.showWelcomeView": false,
  "git.confirmSync": false,
  "git.autofetch": true,
  "editor.minimap.enabled": false,
  "editor.formatOnSave": true,
  "workbench.startupEditor": "none",
  "[typescript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[html]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[javascript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[json]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "github.copilot.enable": {
    "*": false,
    "plaintext": false,
    "markdown": false,
    "scminput": false
  },
  "supermaven.enableFixWithSupermaven": false,
  "redhat.telemetry.enabled": false,
  "cursor.cpp.disabledLanguages": ["plaintext", "markdown", "scminput"],
  "supermaven.enable": {},
  "cursor.composer.shouldAllowCustomModes": true,
  "terminal.integrated.defaultProfile.linux": "fish",
  "workbench.editor.customLabels.patterns": {
    "**/model.*": "model:${dirname}",
    "**/route.*": "route:${dirname}",
    "**/prisma/migrations/*/migration.sql": "migration:${dirname}",
    "**/layout.tsx": "layout:${dirname}",
    "**/layout.client.tsx": "layout:${dirname}:client",
    "**/index.*.*": "idx:${dirname}:${extname(-1)}",
    "**/page.*.*": "page:${dirname}:${extname(-1)}",
    "**/*/@x/*.*.*": "idx:${dirname(1)} → ${filename}:${extname(-1)}",
    "**/index.*": "idx:${dirname}",
    "**/page.tsx": "page:${dirname}",
    "**/*/@x/*.*": "idx:${dirname(1)} → ${filename}"
  },
  "neonLocal.port": 5433,
  "editor.fontFamily": "'Atkinson Hyperlegible Mono', 'Cascadia Code', 'Droid Sans Mono', 'monospace', monospace",
  "editor.codeLensFontFamily": "'Atkinson Hyperlegible Mono', 'Cascadia Code', 'Droid Sans Mono', 'monospace', monospace",
  "editor.inlineSuggest.fontFamily": "'Atkinson Hyperlegible Mono', 'Cascadia Code', 'Droid Sans Mono', 'monospace', monospace",
  "debug.console.fontFamily": "'Atkinson Hyperlegible Mono', 'Cascadia Code', 'Droid Sans Mono', 'monospace', monospace",
  "scm.inputFontFamily": "'Atkinson Hyperlegible Mono', 'Cascadia Code', 'Droid Sans Mono', 'monospace', monospace",
  "terminal.integrated.fontFamily": "'Atkinson Hyperlegible Mono', 'Cascadia Code', 'Droid Sans Mono', 'monospace', monospace",
  "notebook.markup.fontFamily": "'Atkinson Hyperlegible Mono', 'Cascadia Code', 'Droid Sans Mono', 'monospace', monospace",
  "notebook.output.fontFamily": "'Atkinson Hyperlegible Mono', 'Cascadia Code', 'Droid Sans Mono', 'monospace', monospace",
  "editor.fontWeight": "500",
  "editor.fontSize": 13,
  "security.promptForLocalFileProtocolHandling": false,
  "json.schemaDownload.enable": true,
  "[jsonc]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "window.commandCenter": true,
  "workbench.preferredDarkColorTheme": "Tokyo Night Storm",
  "typescript.experimental.useTsgo": false,
  "editor.tabSize": 2,
  "editor.letterSpacing": -0.4,
  "terminal.integrated.letterSpacing": -0.4,
  "cursor.composer.conversationDensity": "detailed"
}
